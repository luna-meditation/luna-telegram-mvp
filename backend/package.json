{
  "name": "@luna/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/package-tarot-catalog.mjs",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/*.test.ts",
    "test:phase1-db": "node --import tsx test/phase1-database-review.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "astronomy-engine": "2.1.19",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.13.1",
    "serverless-http": "4.0.0",
    "telegraf": "^4.16.3",
    "ws": "^8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
