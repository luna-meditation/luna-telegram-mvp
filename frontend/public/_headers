/assets/tarot/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Do not make stable card filenames immutable: future art revisions must refresh.
/assets/optimized/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
